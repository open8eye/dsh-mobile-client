<?xml version="1.0" encoding="utf-8"?>
<!--
  The updater downloads a release APK into the app's cache directory and then
  hands it to the system package installer. Android 7+ forbids passing a
  file:// URI across apps, so it has to travel as a content URI from here.
-->
<paths>
    <cache-path name="updates" path="." />
    <files-path name="files" path="." />
</paths>
